# Copy this file to .env.local for local testing.
# In production, add these same names under Vercel > Project > Settings > Environment Variables.
# Never commit a real .env.local file to GitHub.

GROQ_API_KEY=

DISCORD_WEBHOOK_URL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

MASTODON_BASE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

BLUESKY_IDENTIFIER=you.bsky.social
BLUESKY_APP_PASSWORD=

# One shared password for the app itself (protects the page and posting, not the image link).
# Make up any password you like. Leave blank and the app stays open to anyone with the link.
APP_PASSWORD=
